{
  "name": "@sakana-y/vue-grab",
  "version": "0.1.4",
  "private": false,
  "description": "Grab UI context from Vue apps for AI coding agents.",
  "keywords": [
    "accessibility",
    "ai",
    "component-inspector",
    "debugging",
    "devtools",
    "network",
    "vite",
    "vue"
  ],
  "bugs": {
    "url": "https://github.com/SaKaNa-Y/vue-grab/issues"
  },
  "license": "MIT",
  "author": "SaKaNa-Y",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SaKaNa-Y/vue-grab.git",
    "directory": "packages/vue-grab"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./vite": {
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs",
      "types": "./dist/vite.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run build:css && vite build",
    "build:css": "unocss \"src/**/*.{ts,vue}\" \"node_modules/@antfu/design/components/**/*.vue\" -o src/styles/uno.generated.css",
    "dev:css": "unocss \"src/**/*.{ts,vue}\" \"node_modules/@antfu/design/components/**/*.vue\" -o src/styles/uno.generated.css --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sakana-y/vue-grab-shared": "workspace:*",
    "launch-editor": "^2.9.1",
    "postcss": "^8.5.0",
    "reka-ui": "^2.10.1"
  },
  "devDependencies": {
    "@antfu/design": "^0.2.1",
    "@playwright/test": "^1.50.0",
    "@unocss/cli": "^66.7.4",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/browser": "^4.1.0",
    "@vitest/browser-playwright": "^4.1.0",
    "@vue/test-utils": "^2.4.6",
    "colorjs.io": "^0.6.1",
    "typescript": "~5.9.3",
    "unocss": "^66.7.4",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^4.1.0",
    "vue": "^3.5.13"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
